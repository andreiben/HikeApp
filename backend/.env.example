# PostgreSQL connection string (the project uses NeonDB in development).
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Secret used to sign JWT access tokens (7-day TTL).
# Generate a strong random value, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=

# WeatherAPI.com key, used for forecast, daylight and precipitation history.
# Obtain one at https://www.weatherapi.com/
WEATHER_API_KEY=

# HTTP port for the backend. Optional, defaults to 3000.
PORT=3000

# ntfy.sh topic used for optional push notifications. Optional, disabled when empty.
NTFY_TOPIC=

# Password assigned to the demo persona accounts created by `bun run seed:personas`.
# Required only when running that seed script. Choose your own value.
DEMO_USER_PASSWORD=